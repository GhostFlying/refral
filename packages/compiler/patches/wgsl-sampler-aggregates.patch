+// GLSL ES 1.00 permits constant-index-expressions including normalized loop indices.
+// Evaluate the selector and all texture arguments once before dispatching to scalar bindings.
+void OutputWGSLTraverser::emitIndexedTextureCall(TOperator op, const TIntermSequence &args,
+                                                TIntermSymbol &sampler, TIntermTyped &selector)
+{
+    const bool cube = IsSamplerCube(sampler.getType().getBasicType());
+    const bool projected = op == EOpTexture2DProj || op == EOpTexture2DProjBias ||
+                           op == EOpTexture2DProjLodVS;
+    const bool lod = op == EOpTexture2DLodVS || op == EOpTexture2DProjLodVS ||
+                     op == EOpTextureCubeLodVS;
+    const bool bias = op == EOpTexture2DBias || op == EOpTextureCubeBias ||
+                      op == EOpTexture2DProjBias;
+    if ((!cube && !IsSampler2D(sampler.getType().getBasicType())) ||
+        (!projected && !lod && !bias && op != EOpTexture2D && op != EOpTextureCube)) {
+      mSink << "TODO_UNHANDLED_TEXTURE_FUNCTION()";
+      return;
+    }
+    const unsigned int width = args[1]->getAsTyped()->getNominalSize();
+    const ImmutableString name = BuildConcatenatedImmutableString(
+        "ANGLE_sampleIndexed_", static_cast<unsigned int>(op), "_", width, "_", sampler.getName());
+    if (mSamplerDispatchNames.insert(name).second) {
+      TInfoSinkBase &samplerFunctions = mWGSLGenerationMetadataForUniforms->samplerFunctions;
+      samplerFunctions << "fn " << name << "(index : i32, p : vec" << width << "<f32>";
+      if (bias || lod) samplerFunctions << ", level : f32";
+      samplerFunctions << ") -> vec4<f32> {\n  switch index {\n";
+      const unsigned int count = std::min(mWGSLGenerationMetadataForUniforms->samplerLimit, sampler.getType().getOutermostArraySize());
+      for (unsigned int element = 0; element < count; ++element) {
+        const ImmutableString binding = BuildConcatenatedImmutableString(
+            "gl_RefralElement", element, "_", sampler.getName());
+        const bool explicitLevel = lod || mShaderType == GL_VERTEX_SHADER;
+        samplerFunctions << "    case " << element << ": { return "
+                         << (bias ? "textureSampleBias" : explicitLevel ? "textureSampleLevel" : "textureSample")
+                         << "(" << kAngleTexturePrefix << binding << ", " << kAngleSamplerPrefix
+                         << binding << ", p." << (cube ? "xyz" : "xy");
+        if (projected) samplerFunctions << (width == 3 ? " / p.z" : " / p.w");
+        if (bias || lod) samplerFunctions << ", level";
+        else if (explicitLevel) samplerFunctions << ", 0.0f";
+        samplerFunctions << "); }\n";
+      }
+      samplerFunctions << "    default: { return vec4<f32>(0.0); }\n  }\n}\n";
+    }
+    mSink << name << "(i32(";
+    selector.traverse(this);
+    mSink << ")";
+    for (size_t i = 1; i < args.size(); ++i) {
+      mSink << ", ";
+      args[i]->traverse(this);
+    }
+    mSink << ")";
+}
