+// A component is writable in WGSL but cannot be a pointer operand. Pass its
+// containing vector by reference and evaluate the index and RHS once by value.
+bool OutputWGSLTraverser::emitComponentWrite(TIntermTyped *left, TOperator op, TIntermTyped *right)
+{
+    TIntermSwizzle *swizzle = left->getAsSwizzleNode();
+    TIntermBinary *index = left->getAsBinaryNode();
+    TIntermTyped *vector = nullptr;
+    if (swizzle && swizzle->getSwizzleOffsets().size() == 1) {
+      vector = swizzle->getOperand();
+    } else if (index && (index->getOp() == EOpIndexDirect || index->getOp() == EOpIndexIndirect) &&
+               index->getLeft()->getType().isVector()) {
+      vector = index->getLeft();
+    } else {
+      return false;
+    }
+    const TType &root = FindRootVariable(vector)->getType();
+    const WGSLWrapperFunction fn =
+        mPrelude->assign(vector->getType(), right ? right->getType() : left->getType(), op, &root);
+    mSink << fn.prefix;
+    groupedTraverse(*vector);
+    mSink << ", ";
+    if (swizzle) {
+      mSink << swizzle->getSwizzleOffsets()[0] << "u";
+    } else {
+      mSink << "u32(clamp(i32(";
+      index->getRight()->traverse(this);
+      mSink << "), 0, " << static_cast<unsigned int>(vector->getNominalSize() - 1) << "))";
+    }
+    mSink << ", ";
+    if (right) {
+      right->traverse(this);
+    } else {
+      mSink << "1";
+    }
+    mSink << fn.suffix;
+    return true;
 }
