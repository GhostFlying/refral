+WGSLWrapperFunction WGSLProgramPrelude::aggregateComparison(const TType &type, bool equal)
+{
+    const FuncId id = InsertIntoMapWithUniqueId(mUniqueFuncId, mAggregateComparisons, type);
+    return {BuildConcatenatedImmutableString(equal ? "" : "!", ConcatId("equal", id), "("),
+            kEndParanthesis};
+}
+
+WGSLWrapperFunction WGSLProgramPrelude::matrixComponentMultiply(const TType &type)
+{
+    const FuncId id = InsertIntoMapWithUniqueId(mUniqueFuncId, mMatrixComponentProducts, type);
+    return {BuildConcatenatedImmutableString(ConcatId("matrixCompMult", id), "("),
+            kEndParanthesis};
+}
+
+WGSLWrapperFunction WGSLProgramPrelude::floatModulo(const TType &type)
+{
+    const FuncId id = InsertIntoMapWithUniqueId(mUniqueFuncId, mFloatModuloTypes, type);
+    return {BuildConcatenatedImmutableString(ConcatId("floatMod", id), "("), kEndParanthesis};
+}
+
+WGSLWrapperFunction WGSLProgramPrelude::scalarGeometric(TOperator op)
+{
+    mScalarGeometric.insert(op);
+    switch (op)
+    {
+        case EOpFaceforward:
+            return {ImmutableString("ANGLE_scalarFaceForward("), kEndParanthesis};
+        case EOpReflect:
+            return {ImmutableString("ANGLE_scalarReflect("), kEndParanthesis};
+        case EOpRefract:
+            return {ImmutableString("ANGLE_scalarRefract("), kEndParanthesis};
+        default:
+            UNREACHABLE();
+            return {ImmutableString(""), kEndParanthesis};
@@ -243,0 +328,53 @@
