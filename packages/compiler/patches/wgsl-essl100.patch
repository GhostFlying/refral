@@ -61,0 +63,46 @@
+// Emit early exits for unequal aggregate members. Array lengths can be large, so
+// keep their comparison a loop instead of unrolling it in the generated code.
+void EmitComparison(TInfoSinkBase &sink, const TType &type, const TString &member, size_t depth)
+{
+    TString indent(2 * (depth + 1), ' ');
+    if (type.isArray())
+    {
+        TStringStream index;
+        index << "i" << depth;
+        const TString variable = index.str();
+        sink << indent << "for (var " << variable << " = 0u; " << variable << " < "
+             << type.getOutermostArraySize() << "u; " << variable << "++) {\n";
+        TType element(type);
+        element.toArrayElementType();
+        EmitComparison(sink, element, member + "[" + variable + "]", depth + 1);
+        sink << indent << "}\n";
+    }
+    else if (type.getStruct())
+    {
+        for (const TField *field : type.getStruct()->fields())
+        {
+            TStringStream name;
+            WriteNameOf(name, *field, kUserVariableNamePrefix);
+            EmitComparison(sink, *field->type(), member + "." + name.str(), depth);
+        }
+    }
+    else if (type.isMatrix())
+    {
+        const TType column(EbtFloat, EbpHigh, EvqTemporary, type.getRows());
+        for (unsigned int i = 0; i < type.getCols(); ++i)
+        {
+            TStringStream access;
+            access << member << "[" << i << "]";
+            EmitComparison(sink, column, access.str(), depth);
+        }
+    }
+    else if (type.isVector())
+    {
+        sink << indent << "if (any(a" << member << " != b" << member << ")) { return false; }\n";
+    }
+    else
+    {
+        sink << indent << "if (a" << member << " != b" << member << ") { return false; }\n";
+    }
+}
+
