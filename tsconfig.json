{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@webgpu/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@refral/webgl": ["./packages/webgl/src/index.ts"],
      "@refral/browser-host": ["./packages/browser-host/src/index.ts"],
      "@refral/compiler": ["./packages/compiler/src/index.ts"],
      "@refral/core-api": ["./packages/core-api/src/index.ts"],
      "@refral/core-js": ["./packages/core-js/src/index.ts"],
      "@refral/core-wasm": ["./packages/core-wasm/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts", "tests/**/*.ts", "benchmarks/**/*.ts", "experiments/readback/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "artifacts", "third_party"]
}
