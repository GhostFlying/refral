+// ESSL permits any expression as a statement. WGSL requires the unused value
+// of an ordinary expression to be explicitly discarded. Preserve side effects.
+void OutputWGSLTraverser::emitStatement(TIntermNode &node)
+{
+    TIntermTyped *value = node.getAsTyped();
+    TIntermBinary *binary = node.getAsBinaryNode();
+    TIntermUnary *unary = node.getAsUnaryNode();
+    if (value && value->getBasicType() != EbtVoid &&
+        !(binary && binary->isAssignment()) && !(unary && unary->isAssignment())) {
+      mSink << "_ = ";
     }
+    node.traverse(this);
 }
