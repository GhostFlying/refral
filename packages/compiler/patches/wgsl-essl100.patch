+    for (const auto &[type, id] : mFloatModuloTypes)
+    {
+        TStringStream typeName;
+        WriteWgslType(typeName, type, {});
+        sink << "fn " << ConcatId("floatMod", id) << "(x : " << typeName.str()
+             << ", y : " << typeName.str() << ") -> " << typeName.str()
+             << " { return x - y * floor(x / y); }\n";
+    }
+    if (mScalarGeometric.count(EOpFaceforward))
+    {
+        sink << "fn ANGLE_scalarFaceForward(n : f32, i : f32, nref : f32) -> f32 {\n"
+             << "  return select(-n, n, nref * i < 0.0f);\n}\n";
+    }
+    if (mScalarGeometric.count(EOpReflect))
+    {
+        sink << "fn ANGLE_scalarReflect(i : f32, n : f32) -> f32 {\n"
+             << "  return i - 2.0f * (n * i) * n;\n}\n";
+    }
+    if (mScalarGeometric.count(EOpRefract))
+    {
+        sink << "fn ANGLE_scalarRefract(i : f32, n : f32, eta : f32) -> f32 {\n"
+             << "  let ni = n * i;\n"
+             << "  let k = 1.0f - eta * eta * (1.0f - ni * ni);\n"
+             << "  if (k < 0.0f) { return 0.0f; }\n"
+             << "  return eta * i - (eta * ni + sqrt(k)) * n;\n}\n";
+    }
