{
  "name": "refral",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "deps:sync": "node tools/deps-sync.mjs",
    "compiler:build": "node tools/compiler-build.mjs",
    "compiler:test": "node tools/compiler-test.mjs",
    "core:build": "node tools/core-selection-build.mjs",
    "core:bench": "node tools/core-selection-run.mjs",
    "rust:check": "node tools/rust.mjs check",
    "rust:test": "node tools/rust.mjs test",
    "rust:test:wasm": "pnpm --filter @refral/core-wasm test:wasm",
    "rust:build": "node tools/rust.mjs build",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "ci:check": "node --test tools/ci.test.mjs && node tools/ci.mjs verify && node tools/check-support.mjs",
    "test:unit": "vitest run",
    "test:tools": "node --test tools/conformance-adapter.test.mjs tools/conformance-assets.test.mjs tools/conformance-run-state.test.mjs tools/conformance-report.test.mjs tools/deps-conformance.test.mjs",
    "test:chrome": "playwright test",
    "test:probe": "playwright test probe.spec.ts",
    "test:cts": "playwright test cts.spec.ts",
    "conformance:deps": "node --use-env-proxy tools/deps-conformance.mjs",
    "conformance:run": "node tools/conformance-run.mjs",
    "conformance:report": "node tools/conformance-report.mjs",
    "test:buffers": "playwright test buffers.spec.ts",
    "test:drawing": "playwright test dual-core-drawing.spec.ts",
    "test:readback": "playwright test -c experiments/readback/playwright.config.ts",
    "test:readback:compare": "playwright test -c experiments/readback/comparison.config.ts",
    "test:readpixels": "playwright test read-pixels.spec.ts",
    "bench:readpixels": "playwright test -c benchmarks/readpixels.config.ts",
    "bench:readback": "playwright test -c experiments/readback/comparison-benchmark.config.ts",
    "test:dist": "node tools/verify-dist.mjs",
    "snapshot": "node tools/snapshot.mjs",
    "bench:chrome": "playwright test -c benchmarks/playwright.config.ts rtt-benchmark.spec.ts",
    "bench:rtt": "playwright test -c benchmarks/playwright.config.ts rtt-benchmark.spec.ts",
    "bench:three": "playwright test -c benchmarks/playwright.config.ts three-shapes.spec.ts",
    "bench:three:heavy": "REFRAL_HEADLESS=1 playwright test -c benchmarks/playwright.config.ts three-heavy.spec.ts",
    "check": "pnpm typecheck && pnpm test:unit && pnpm test:tools && pnpm rust:check && pnpm rust:test && node tools/check-support.mjs",
    "bench:dom": "playwright test -c benchmarks/dom-upload.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.162.0",
    "@webgpu/types": "0.1.74",
    "pngjs": "7.0.0",
    "three": "0.162.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
